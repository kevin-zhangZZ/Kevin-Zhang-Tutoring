// 2018 Specialist Mathematics — Exam 2, MCQ 20. VCAA examination report: 56% correct.
// P(one normal variable > an independent second normal variable), via their difference.
// Question text transcribed from the original paper; solution is original. Value checked
// (0.37157); agrees with itute (B). Distractors verified numerically: A = variances subtracted,
// sd √51 (0.28770); C = standard deviations added, sd 17 (0.40699); D = 1 − A (0.71230, variances
// subtracted and the other tail); E = Φ(4/3) (0.90879, sds subtracted to 3 and the other tail).
//
// Interactive (extras): interactives/spec-2018-mcq20-differences — a histogram of 500 simulated
// differences M − S with the normal curve for the chosen rule over it: variances add (fits, area
// 0.3716), variances subtract (too narrow, 0.2877 = A) or sds add (too wide, 0.4070 = C).
// WrongMethods: variances subtract (option A, 13%) and sds add (option C, 16%).

import Katex from '../../../components/Katex'
import { MCQShell } from '../MCQShell'
import { Background, WrongMethod, type WorkingRow, type MCQExaminerStats } from '../QuestionParts'
import { Cas } from '../CasRef'
import { Explore, lazyWidget } from '../Explore'

const Differences = lazyWidget(() => import('../interactives/spec-2018-mcq20-differences'))

const EXAMINER: MCQExaminerStats = {
  percentages: { A: 13, B: 56, C: 16, D: 10, E: 4 },
  answer: 'B',
  noAnswer: 1,
}

const ROWS: WorkingRow[] = [
  {
    working: <Katex display tex="M \sim N(71, 10^2), \qquad S \sim N(75, 7^2)" />,
    reason: <>A randomly chosen Mathematics score and a randomly chosen Statistics score, independent of each other.</>,
  },
  {
    working: <Katex display tex="\Pr(M>S) = \Pr(M-S>0)" />,
    reason: <>How would I know to do this? Both scores are random, so there is no fixed number to compare either one with. Turn the comparison into a statement about <em>one</em> random variable, <Katex tex="D=M-S" />: "Maths higher" is the same as "<Katex tex="D" /> positive".</>,
  },
  {
    working: (
      <>
        <Katex display tex="\begin{aligned} \mathrm{E}(D) &= 71-75 \\ &= -4 \end{aligned}" />
        <Katex display tex="\begin{aligned} \mathrm{Var}(D) &= 1^2\times10^2+(-1)^2\times7^2 \\ &= 149 \end{aligned}" />
      </>
    ),
    reason: <>For independent variables, <Katex tex="\mathrm{Var}(aM+bS)=a^2\,\mathrm{Var}(M)+b^2\,\mathrm{Var}(S)" />. Here <Katex tex="b=-1" />, and <Katex tex="(-1)^2=1" />: the minus sign changes the mean, but the variance of a <em>difference</em> still <em>adds</em>.</>,
  },
  {
    working: <Katex display tex="D \sim N(-4,\,149), \qquad \mathrm{sd}(D)=\sqrt{149}\approx12.207" />,
    reason: <>A difference of independent normal variables is itself normal, so only its mean and standard deviation are needed.</>,
  },
  {
    working: <Katex display tex="\begin{aligned} \Pr(D>0) &= \Pr\!\left(Z > \frac{0-(-4)}{\sqrt{149}}\right) \\ &= \Pr(Z>0.3277) \end{aligned}" />,
    reason: <>Standardise. On CAS: <Cas fn="normCdf">normCdf(0, ∞, −4, √149)</Cas>.</>,
  },
  {
    working: <Katex display tex="\boxed{\Pr(Z>0.3277) \approx 0.3716}" />,
    reason: <>Matches option <b>B</b>. Option <b>A</b> <Katex tex="(0.2877)" /> subtracts the variances (<Katex tex="100-49=51" />), and option <b>C</b> <Katex tex="(0.4070)" /> adds the standard deviations (<Katex tex="10+7=17" />). Option <b>D</b> <Katex tex="(0.7123)" /> is <Katex tex="1-0.2877" />: variances subtracted <em>and</em> the wrong tail, <Katex tex="\Pr(D<0)" />. Option <b>E</b> <Katex tex="(0.9088)" /> subtracts the standard deviations (<Katex tex="10-7=3" />) and takes the wrong tail. Sense check: the Maths mean is <Katex tex="4" /> lower, so Maths beats Statistics less than half the time. That rules out D and E at once.</>,
  },
]

export default function SpecialistQ20_2018() {
  return (
    <MCQShell
      question={
        <>
          <p className="mb-2">
            The scores on the Mathematics and Statistics tests, expressed as percentages, in a particular
            year were both normally distributed. The mean and the standard deviation of the Mathematics
            test scores were 71 and 10 respectively, while the mean and the standard deviation of the
            Statistics test scores were 75 and 7 respectively.
          </p>
          <p>
            Assuming the sets of test scores were independent of each other, the probability, correct to four
            decimal places, that a randomly chosen Mathematics score is higher than a randomly chosen
            Statistics score is
          </p>
        </>
      }
      options={[
        { letter: 'A', content: <Katex tex="0.2877" /> },
        { letter: 'B', content: <Katex tex="0.3716" />, isAnswer: true },
        { letter: 'C', content: <Katex tex="0.4070" /> },
        { letter: 'D', content: <Katex tex="0.7123" /> },
        { letter: 'E', content: <Katex tex="0.9088" /> },
      ]}
      rows={ROWS}
      examinerReport={EXAMINER}
      background={
        <Background title="Why variances add, even for a difference">
          <p>
            For independent <Katex tex="X" /> and <Katex tex="Y" />,{' '}
            <Katex tex="\mathrm{Var}(aX+bY)=a^2\,\mathrm{Var}(X)+b^2\,\mathrm{Var}(Y)" />. The coefficients are squared,
            so <Katex tex="\mathrm{Var}(X-Y)=\mathrm{Var}(X)+\mathrm{Var}(Y)" />.
          </p>
          <p>
            In words: <Katex tex="-Y" /> is exactly as spread out as <Katex tex="Y" />, just flipped. Each score brings
            its own uncertainty, and combining two uncertain things, by adding or subtracting, can only make the result{' '}
            <em>more</em> uncertain. A high Maths score paired with a low Statistics score makes a large positive
            difference; the reverse makes a large negative one. It is the variances that add, not the standard
            deviations: <Katex tex="\mathrm{sd}(D)=\sqrt{10^2+7^2}" />, like the hypotenuse of a right triangle.
          </p>
        </Background>
      }
      extras={
        <>
          <Explore title="Why the variances add for a difference">
            <Differences />
          </Explore>
          <WrongMethod
            title="A difference, so subtract the variances"
            source="13% chose A"
            working={
              <>
                <Katex display tex="\mathrm{Var}(D)=100-49=51" />
                <Katex display tex="\Pr\!\left(Z>\tfrac{4}{\sqrt{51}}\right)\approx0.2877" />
              </>
            }
          >
            <p>
              That would make <Katex tex="M-S" /> <em>less</em> variable than <Katex tex="M" /> alone, as though bringing
              in a second random score made the outcome more predictable. The minus sign is squared
              away: <Katex tex="(-1)^2\,\mathrm{Var}(S)=+49" />. To catch it, check the result is more spread than
              either score on its own: <Katex tex="\sqrt{149}\approx12.2" /> is bigger than both <Katex tex="10" /> and{' '}
              <Katex tex="7" />.
            </p>
          </WrongMethod>
          <WrongMethod
            title="Spreads combine, so add the standard deviations"
            source="16% chose C"
            working={
              <>
                <Katex display tex="\mathrm{sd}(D)=10+7=17" />
                <Katex display tex="\Pr\!\left(Z>\tfrac{4}{17}\right)\approx0.4070" />
              </>
            }
          >
            <p>
              The right instinct, applied to the wrong quantity. It is the <em>variances</em> that add; the standard
              deviation is the square root of the total, <Katex tex="\sqrt{100+49}\approx12.2" />, which is less than{' '}
              <Katex tex="10+7" />. Standard deviations would add only if the two scores always moved together, and
              independent scores do not.
            </p>
          </WrongMethod>
        </>
      }
    />
  )
}
